# KEEP PRIVATE. Never paste your real key into device firmware, web HTML or git.
OPENAI_API_KEY=REPLACE_WITH_YOUR_OWN_KEY
QIPIQ_DEVICE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_DEVICE_PASSWORD
QIPIQ_DEMO_MODE=false
QIPIQ_TEXT_MODEL=gpt-4o-mini
QIPIQ_STT_MODEL=gpt-transcribe
# TEMPORARY API: shutdown scheduled 2027-01-06. Migrate to Realtime voice before production.
QIPIQ_TTS_MODEL=gpt-4o-mini-tts
QIPIQ_TTS_VOICE=marin
QIPIQ_REQUESTS_PER_MINUTE=12
QIPIQ_REQUESTS_PER_DAY=150
